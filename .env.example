# ==========================================
# FormBharlo Production Environment Configuration
# ==========================================

# 1. Site Metadata & Canonical URLs
NEXT_PUBLIC_SITE_URL=https://formbharlo.in

# 2. Google AdSense & Monetization (e.g. ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# 3. Community Channels & Audience Funnels
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/formbharlo
NEXT_PUBLIC_WHATSAPP_URL=https://whatsapp.com/channel/formbharlo

# 4. Admin Security & Dashboard Authentication
ADMIN_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long
ADMIN_PASSWORD=change_this_admin_password_in_production

# 5. GitHub Personal Access Token (for syncing job statuses back to repo)
GITHUB_PAT=ghp_your_github_personal_access_token_here
